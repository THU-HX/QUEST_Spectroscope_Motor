# Python 编译产物
__pycache__/
*.pyc

# 运行时本机配置（offset/range 默认值已固化在 gui_motor1.py 的 DEFAULT_CONFIG，
# 此文件只是本机覆盖，会随显示比例滑条等改动频繁变化，不进版本库）
motor_config.json

# 调试助手本机配置（url/key/默认模型，含 API key，不进版本库）
chat_config.json

# 调试助手语义操作的阈值（按现场实机调，每台不同；默认值固化在 chat_assistant.py 的 DEFAULT_OPS）
assistant_ops.json

# 自测截图产物（snap.py 渲染出来的临时 PNG）
_*.png

# 运行时保存的日志
logs/

# 虚拟环境
venv/
.venv/
